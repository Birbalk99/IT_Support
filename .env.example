# Production .env file
# Copy from .env.example and fill in your values
# Application Configuration
PROJECT_NAME="IT Help Desk Backend"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
# Security Configuration
# SECRET_KEY: JWT Token encryption ke liye (LLM ke liye NAHI)
# Generate: openssl rand -hex 32
SECRET_KEY="d87cc423ad4045ae85020d2e2e1c2f126145701771d521e152d53533041a4691"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Security Features (Set to False to disable easily)
# Ye features easily on/off kar sakte ho without code changes
ENABLE_USER_ID_VALIDATION=False
ENABLE_URL_WHITELIST=False

# Rate Limiting (Set RATE_LIMIT_ENABLED=False to completely disable)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=60
# Database
DATABASE_URL="sqlite:///./it_helpdesk.db"
# Logging
LOG_RETENTION_DAYS=10
LOG_LEVEL="INFO"
# Redis (Optional - for caching and distributed rate limiting)
REDIS_URL=""
# ============================================
# LLM Configuration (AI Agent Settings)
# ============================================
# Agent Configuration
AGENT_NAME="AU IT Help Desk Agent"
AGENT_VERSION="1.0.0"
AGENT_DESCRIPTION="AU IT Help Desk Assistant powered by AI"
# LLM Provider: openai, azure_openai, groq
LLM_PROVIDER="groq"
# OpenAI Configuration
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE=1.0
GROQ_MAX_TOKENS=8192
GROQ_TOP_P=1.0
# Azure OpenAI Configuration (if using Azure)
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT_NAME=""
AZURE_OPENAI_API_VERSION="2024-02-01"
# LLM Features
LLM_ENABLE_TICKET_ANALYSIS=True
LLM_ENABLE_AUTO_RESPONSE=True
LLM_ENABLE_SENTIMENT_ANALYSIS=True

